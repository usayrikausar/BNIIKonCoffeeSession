# Copy this file to .env.local (local) or paste each value into Vercel →
# Project → Settings → Environment Variables (production). Never commit real values.

# --- App -------------------------------------------------------------------
# Public URL of the app, no trailing slash. Used in chat links, QR codes, embed
# snippet and emails. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / publishable key — safe in the browser, RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) --------------------------
ANTHROPIC_API_KEY=
# Model used by the agent engine. Change without code changes.
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. "low" = fastest, cheapest replies.
ANTHROPIC_EFFORT=low
# Server-side refusal fallback ("default" = Anthropic picks a fallback model if
# the main model declines). Set to "off" if your model/platform doesn't support it.
ANTHROPIC_FALLBACKS=default

# --- Email (resend.com → API Keys) -----------------------------------------
# If empty, emails are printed to the server log instead of sent (dev mode).
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Layankan <noti@layankan.com>"
EMAIL_FROM=Layankan <onboarding@resend.dev>

# --- Background jobs -------------------------------------------------------
# Long random string. Vercel Cron sends it automatically as a Bearer token.
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Secrets encryption (channel credentials, Phase 2 WhatsApp tokens) -----
# Comma-separated list of keyId:base64Key (32-byte keys). Newest key last.
# Rotate by APPENDING a new key and setting ENCRYPTION_KEY_CURRENT to it;
# keep old keys until all credentials are re-encrypted.
# Generate a key: openssl rand -base64 32
ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_KEY_CURRENT=k1

# --- Abuse protection (public chat) ----------------------------------------
# Messages allowed per visitor (IP) per minute, and per tenant per hour.
RATE_LIMIT_PER_IP_PER_MIN=12
RATE_LIMIT_PER_TENANT_PER_HOUR=600

# --- Phase 2 (WhatsApp) — not needed yet -----------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# MURPATI_API_BASE_URL=
# MURPATI_WEBHOOK_SECRET=
