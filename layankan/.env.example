# Copy this file to .env.local (local) or paste each value into Vercel →
# Project → Settings → Environment Variables (production). Never commit real values.

# --- App -------------------------------------------------------------------
# Public URL of the app, no trailing slash. Used in chat links, QR codes, embed
# snippet and emails. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / publishable key — safe in the browser, RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) --------------------------
ANTHROPIC_API_KEY=
# Model used by the agent engine. Change without code changes.
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. "low" = fastest, cheapest replies.
ANTHROPIC_EFFORT=low
# Server-side refusal fallback ("default" = Anthropic picks a fallback model if
# the main model declines). Set to "off" if your model/platform doesn't support it.
ANTHROPIC_FALLBACKS=default

# --- Email (resend.com → API Keys) -----------------------------------------
# If empty, emails are printed to the server log instead of sent (dev mode).
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Layankan <noti@layankan.com>"
EMAIL_FROM=Layankan <onboarding@resend.dev>

# --- Background jobs -------------------------------------------------------
# Long random string. Vercel Cron sends it automatically as a Bearer token.
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Secrets encryption (channel credentials, Phase 2 WhatsApp tokens) -----
# Comma-separated list of keyId:base64Key (32-byte keys). Newest key last.
# Rotate by APPENDING a new key and setting ENCRYPTION_KEY_CURRENT to it;
# keep old keys until all credentials are re-encrypted.
# Generate a key: openssl rand -base64 32
ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_KEY_CURRENT=k1

# --- Abuse protection (public chat) ----------------------------------------
# Messages allowed per visitor (IP) per minute, and per tenant per hour.
RATE_LIMIT_PER_IP_PER_MIN=12
RATE_LIMIT_PER_TENANT_PER_HOUR=600

# --- WhatsApp: direct Meta Cloud API (official) -----------------------------
# From developers.facebook.com → your app. See README "WhatsApp setup".
NEXT_PUBLIC_META_APP_ID=
# App → Settings → Basic → App secret. Signs every webhook; SERVER ONLY.
META_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp → Embedded Signup → Configuration ID.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Graph API version your app uses (e.g. v23.0).
META_GRAPH_VERSION=v23.0
# Your OWN Meta Business ID — any client WABA owned by this ID is flagged as
# "not client-owned" (bad for portability).
META_PLATFORM_BUSINESS_ID=

# --- WhatsApp: Murpati (official-API numbers only) ---------------------------
# Per-client API keys and webhook secrets are entered in the dashboard and
# stored encrypted — not here.
MURPATI_API_BASE_URL=https://murpati.com/api/v1

# --- Owner alerts & daily summary over WhatsApp --------------------------------
# Sent FROM this workspace's WhatsApp number (default: tenant #1, Layankan).
PLATFORM_TENANT_ID=00000000-0000-4000-8000-000000000001
# Approved templates in THAT number's WhatsApp account (see README).
WA_TEMPLATE_HANDOFF=layankan_handoff_alert
WA_TEMPLATE_DAILY_SUMMARY=layankan_daily_summary
WA_TEMPLATE_LANGUAGE=ms

# --- Billing (Phase 3) -------------------------------------------------------
# Which gateway NEW invoices use: billplz | toyyibpay | manual (bank transfer,
# marked paid by you in /admin). Plans & prices live in the `plans` table.
BILLING_GATEWAY=manual
# Shown on unpaid invoices when BILLING_GATEWAY=manual (bank, account no., name).
BILLING_BANK_DETAILS=
# Founding Offer slots shown on the Billing page.
FOUNDING_SLOTS=3
# Billplz (billplz.com → Settings → Keys & Integration). Sandbox: billplz-sandbox.com
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=true
# ToyyibPay (toyyibpay.com → Settings). Sandbox: dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_SANDBOX=true

# --- Optional: testing only ------------------------------------------------------
# Leave these EMPTY in production. The automated tests point them at fake
# services so no real Meta / Billplz / ToyyibPay account is ever touched.
# META_GRAPH_BASE_URL=http://localhost:4010
# BILLPLZ_API_BASE_URL=http://localhost:4010
# TOYYIBPAY_API_BASE_URL=http://localhost:4010

# --- Platform admin ------------------------------------------------------------
# Comma-separated emails allowed to open /admin (must be verified logins).
PLATFORM_ADMIN_EMAILS=
